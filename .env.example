# PostgreSQL
POSTGRES_PASSWORD=

# Backend
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__Default=Host=postgres;Port=5432;Database=photoratingdb;Username=postgres;Password=
AdminKey=
AllowedOrigins=https://yourdomain.com
FrontendUrl=https://yourdomain.com
UploadPath=/app/uploads

# JWT (required — generate a long random secret for Jwt__Key)
Jwt__Key=
Jwt__Issuer=PhotoRating
Jwt__Audience=PhotoRating
Jwt__ExpiryDays=7

# Frontend (build-time) — leave empty when nginx handles the proxy
VITE_API_URL=
